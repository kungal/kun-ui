{
  "name": "@kungal/ui-core",
  "version": "2.35.1",
  "description": "KunUI framework-agnostic core — design types, cn(), variant matrix, radius system, utils. No Vue/React.",
  "type": "module",
  "keywords": [
    "kungal",
    "kun-ui",
    "classnames",
    "cn",
    "tailwind-merge",
    "variants",
    "design-system"
  ],
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kungal/kun-ui.git",
    "directory": "packages/ui-core"
  },
  "homepage": "https://github.com/kungal/kun-ui#readme",
  "bugs": "https://github.com/kungal/kun-ui/issues",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "gen:icons": "node scripts/gen-icons.mjs",
    "gen:icons:flutter": "node scripts/gen-icons-flutter.mjs",
    "gen:scales": "node scripts/gen-tw-scales.mjs",
    "gen:motion": "node scripts/gen-motion.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.111",
    "@iconify-json/svg-spinners": "^1.2.4",
    "oslllo-svg-fixer": "^6.0.1",
    "svg2ttf": "^6.1.0",
    "svgicons2svgfont": "^16.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.7.0"
  }
}
