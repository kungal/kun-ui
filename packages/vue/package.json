{
  "name": "@kungal/ui-vue",
  "version": "1.10.0",
  "description": "KunUI Vue 3 component layer — Nuxt-decoupled. Works in any Vue app; pairs with @kungal/ui-nuxt for Nuxt sugar.",
  "type": "module",
  "keywords": [
    "kungal",
    "kun-ui",
    "vue",
    "vue3",
    "components",
    "component-library",
    "ui",
    "design-system"
  ],
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kungal/kun-ui.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/kungal/kun-ui#readme",
  "bugs": "https://github.com/kungal/kun-ui/issues",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css",
    "*.vue"
  ],
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./prose.css": "./dist/prose.css"
  },
  "scripts": {
    "build": "vite build && cp src/prose.css dist/prose.css && vue-tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@floating-ui/vue": "^1.1.11",
    "@kungal/ui-core": "workspace:*",
    "@vueuse/core": "^14.3.0",
    "@vueuse/integrations": "^14.3.0",
    "date-fns": "^4.1.0",
    "focus-trap": "^8.2.1",
    "vue-advanced-cropper": "^2.8.9"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@kungal/ui-tokens": "workspace:*",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "^5.7.0",
    "vite": "^8.0.16",
    "vue": "^3.5.35",
    "vue-tsc": "^3.3.3"
  }
}
