{
  "name": "@kun/ui-nuxt",
  "version": "0.0.1",
  "description": "KunUI Nuxt Layer — wraps @kun/ui-vue, auto-imports the components, and injects NuxtLink + @nuxt/icon so existing Nuxt apps keep their exact DX.",
  "type": "module",
  "main": "./nuxt.config.ts",
  "files": [
    "app",
    "nuxt.config.ts"
  ],
  "scripts": {
    "clean": "rm -rf .nuxt"
  },
  "dependencies": {
    "@kun/tokens": "workspace:*",
    "@kun/ui-vue": "workspace:*",
    "@nuxt/icon": "^2.2.3",
    "@nuxt/image": "^2.0.0",
    "@nuxt/kit": "^4.4.7"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "nuxt": "^4.4.7",
    "vue": "^3.5.35",
    "vue-tsc": "^3.3.3"
  }
}
