{
  "name": "kun-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "KunUI — cross-framework component library. Shared design tokens + framework-agnostic core, with Vue/Nuxt and (planned) React render layers.",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "build:docs": "pnpm --filter @kungal/docs build",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "typecheck:apps": "pnpm -r --filter \"./apps/*\" typecheck",
    "clean": "pnpm -r --filter \"./packages/*\" clean",
    "gen": "pnpm gen:tokens && pnpm gen:icons && pnpm gen:meta && pnpm gen:page-md && pnpm gen:changelog && pnpm gen:upgrade && pnpm gen:llms",
    "gen:tokens": "pnpm --filter @kungal/ui-tokens gen",
    "gen:icons": "pnpm --filter @kungal/ui-core gen:icons",
    "gen:meta": "pnpm --filter @kungal/docs gen:meta",
    "gen:page-md": "pnpm --filter @kungal/docs gen:page-md",
    "gen:changelog": "pnpm --filter @kungal/docs gen:changelog",
    "gen:upgrade": "pnpm --filter @kungal/docs gen:upgrade",
    "gen:llms": "node scripts/gen-llms.mjs",
    "changeset": "changeset",
    "ci:version": "changeset version",
    "ci:publish": "pnpm -r --filter \"./packages/*\" build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.2"
}
